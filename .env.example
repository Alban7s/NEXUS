# GitHub
GITHUB_OWNER=your-github-owner
GITHUB_REPO=your-nexus-repo
GITHUB_TOKEN=

# Prometheus
PROMETHEUS_URL=http://localhost:9090

# Argo CD
ARGOCD_URL=https://argocd.example.com
ARGOCD_TOKEN=

# AWS
AWS_REGION=us-east-1
# Use the normal AWS credential chain (profile, environment, IAM role).

# --- Upload-first deploy pipeline ----------------------------------------

# REQUIRED before exposing the /api/deploy endpoint beyond your own machine.
# Every upload request must send this in the X-Nexus-Api-Key header.
NEXUS_API_KEY=

# Where NEXUS extracts/builds uploads. Needs to be writable, and NEXUS
# needs access to a Docker socket to build/run images.
NEXUS_WORK_DIR=/tmp/nexus-jobs

# Set this to publish built images to ECR. Repos are auto-created per app,
# e.g. 123456789.dkr.ecr.us-east-1.amazonaws.com
ECR_REPOSITORY_PREFIX=

# Kubernetes target for "direct" mode (used when GitOps isn't configured).
K8S_NAMESPACE=default
INGRESS_DOMAIN=
INGRESS_CLASS=nginx

# GitOps target. If set together with ARGOCD_URL above, NEXUS commits
# manifests here instead of touching the cluster directly (recommended).
GIT_REPO_URL=
GIT_BRANCH=main
GIT_MANIFESTS_PATH=apps
GIT_USER_NAME=nexus-bot
GIT_USER_EMAIL=nexus-bot@local

# Host the browser can reach for local-preview links (zero-infra fallback).
NEXUS_PUBLIC_HOST=localhost
